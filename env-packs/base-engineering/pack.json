{
  "kind": "EnvironmentPack",
  "id": "base-engineering",
  "name": "Base Engineering",
  "version": "0.1.0",
  "description": "A general software delivery environment with code, review, and verification capabilities.",
  "tools": ["github", "jira", "shell", "mcp"],
  "skills": ["requirements-clarifier", "solution-proposal", "coder", "pr-review", "test-runner"],
  "knowledge": [
    { "id": "repo-index", "kind": "repo-index", "label": "Repository Index" },
    { "id": "architecture-docs", "kind": "docs", "label": "Architecture Docs" },
    { "id": "runbooks", "kind": "runbook", "label": "Runbooks" }
  ],
  "policies": ["approval-for-high-risk-actions", "no-prod-write-without-review"],
  "workflowBindings": [
    {
      "workflow": "feature-delivery",
      "phases": {
        "clarify": ["requirements-clarifier"],
        "plan": ["solution-proposal"],
        "implement": ["coder"],
        "review": ["pr-review"],
        "verify": ["test-runner"]
      }
    }
  ],
  "taskLabels": [
    {
      "value": "implementation",
      "label": "Implementation",
      "action": "codex_dispatch",
      "workflow": "feature-delivery",
      "phase": "implement",
      "description": "General engineering implementation task for Codex."
    },
    {
      "value": "backend",
      "label": "Backend",
      "action": "codex_dispatch",
      "workflow": "feature-delivery",
      "phase": "implement",
      "description": "Backend code work in the base engineering workflow."
    },
    {
      "value": "docs",
      "label": "Docs",
      "action": "codex_dispatch",
      "workflow": "feature-delivery",
      "phase": "implement",
      "description": "Documentation work that Codex can execute."
    },
    {
      "value": "codex-fix",
      "label": "Codex fix",
      "action": "codex_fix",
      "workflow": "feature-delivery",
      "phase": "implement",
      "description": "Fix blocking review issues with Codex.",
      "aliases": ["needs-codex-fix"]
    },
    {
      "value": "needs-claude-review",
      "label": "Claude review",
      "action": "claude_code_review",
      "workflow": "feature-delivery",
      "phase": "review",
      "description": "Ask the Claude Code plugin to review the task.",
      "aliases": ["claude-review"]
    },
    {
      "value": "needs-human-review",
      "label": "Human review",
      "action": "human_review",
      "workflow": "feature-delivery",
      "phase": "review",
      "description": "Route the task to a human reviewer.",
      "aliases": ["human-review"]
    },
    {
      "value": "worktree",
      "label": "Worktree",
      "action": "maintenance_manual",
      "description": "Workspace or worktree maintenance; not Codex coding work."
    },
    {
      "value": "maintenance",
      "label": "Maintenance",
      "action": "maintenance_manual",
      "description": "Manual maintenance task.",
      "aliases": ["workspace-maintenance"]
    },
    {
      "value": "loop-complete",
      "label": "Loop complete",
      "action": "loop_complete",
      "workflow": "feature-delivery",
      "phase": "review",
      "description": "Mark the review loop complete."
    }
  ],
  "evaluators": ["risk-evaluator", "rollout-safety-check"]
}
