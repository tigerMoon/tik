{
  "kind": "EnvironmentPack",
  "id": "design-to-code",
  "name": "Design To Code",
  "version": "0.1.0",
  "description": "A frontend-oriented environment for design-system knowledge, UI review, and design-to-code delivery.",
  "tools": ["figma", "github", "frontend-preview", "mcp"],
  "skills": ["figma-to-react", "ui-review", "token-consistency-check", "frontend-implementation"],
  "knowledge": [
    { "id": "design-system", "kind": "design-system", "label": "Design System" },
    { "id": "frontend-repo-index", "kind": "repo-index", "label": "Frontend Repo Index" },
    { "id": "ui-guidelines", "kind": "docs", "label": "UI Guidelines" }
  ],
  "policies": ["design-review-before-publish", "token-consistency-required"],
  "workflowBindings": [
    {
      "workflow": "feature-delivery",
      "phases": {
        "clarify": ["requirements-clarifier"],
        "plan": ["solution-proposal", "ui-review"],
        "implement": ["figma-to-react", "frontend-implementation"],
        "review": ["ui-review", "token-consistency-check"],
        "verify": ["frontend-preview"]
      }
    }
  ],
  "taskLabels": [
    {
      "value": "frontend",
      "label": "Frontend",
      "action": "codex_dispatch",
      "workflow": "feature-delivery",
      "phase": "implement",
      "description": "Frontend implementation task for Codex."
    },
    {
      "value": "ui-review",
      "label": "UI review",
      "action": "claude_code_review",
      "workflow": "feature-delivery",
      "phase": "review",
      "description": "Ask Claude Code plugin to review the UI changes."
    },
    {
      "value": "needs-claude-review",
      "label": "Claude review",
      "action": "claude_code_review",
      "workflow": "feature-delivery",
      "phase": "review",
      "description": "Ask the Claude Code plugin to review the task.",
      "aliases": ["claude-review"]
    },
    {
      "value": "codex-fix",
      "label": "Codex fix",
      "action": "codex_fix",
      "workflow": "feature-delivery",
      "phase": "implement",
      "description": "Fix blocking UI review issues with Codex.",
      "aliases": ["needs-codex-fix"]
    },
    {
      "value": "needs-human-review",
      "label": "Human review",
      "action": "human_review",
      "workflow": "feature-delivery",
      "phase": "review",
      "description": "Route the task to a human design or product reviewer.",
      "aliases": ["human-review"]
    },
    {
      "value": "manual",
      "label": "Manual",
      "action": "maintenance_manual",
      "description": "Manual design or workspace step; not Codex coding work."
    },
    {
      "value": "loop-complete",
      "label": "Loop complete",
      "action": "loop_complete",
      "workflow": "feature-delivery",
      "phase": "review",
      "description": "Mark the review loop complete."
    }
  ],
  "evaluators": ["ux-consistency-evaluator", "token-consistency-check"]
}
