{
  "kind": "EnvironmentPack",
  "id": "commerce-ops",
  "name": "Commerce Ops",
  "version": "0.1.0",
  "description": "A commerce-focused environment for API compatibility, incident review, and service delivery.",
  "tools": ["github", "jira", "clickhouse", "kubernetes", "feishu"],
  "skills": ["pr-review", "api-compat-check", "incident-rca", "sql-slow-query-analysis"],
  "knowledge": [
    { "id": "repo-index", "kind": "repo-index", "label": "Workspace Repo Index" },
    { "id": "incident-history", "kind": "incident-history", "label": "Incident History" },
    { "id": "operations-runbooks", "kind": "runbook", "label": "Operations Runbooks" }
  ],
  "policies": ["prod-change-requires-approval", "pii-redaction", "forbidden-direct-db-write"],
  "workflowBindings": [
    {
      "workflow": "feature-delivery",
      "phases": {
        "clarify": ["requirements-clarifier"],
        "plan": ["solution-proposal", "api-compat-check"],
        "implement": ["coder", "api-compat-check"],
        "review": ["pr-review"],
        "verify": ["test-runner", "rollout-safety-check"]
      }
    },
    {
      "workflow": "incident-response",
      "phases": {
        "clarify": ["incident-rca"],
        "plan": ["incident-rca"],
        "verify": ["incident-rca"]
      }
    }
  ],
  "taskLabels": [
    {
      "value": "backend",
      "label": "Backend",
      "action": "codex_dispatch",
      "workflow": "feature-delivery",
      "phase": "implement",
      "description": "Backend code work in the commerce operations environment."
    },
    {
      "value": "api-compat",
      "label": "API compatibility",
      "action": "codex_dispatch",
      "workflow": "feature-delivery",
      "phase": "implement",
      "description": "API compatibility work that Codex can execute with the commerce-ops checks."
    },
    {
      "value": "codex-fix",
      "label": "Codex fix",
      "action": "codex_fix",
      "workflow": "feature-delivery",
      "phase": "implement",
      "description": "Fix blocking review issues with Codex.",
      "aliases": ["needs-codex-fix"]
    },
    {
      "value": "needs-claude-review",
      "label": "Claude review",
      "action": "claude_code_review",
      "workflow": "feature-delivery",
      "phase": "review",
      "description": "Ask the Claude Code plugin to review the task.",
      "aliases": ["claude-review"]
    },
    {
      "value": "needs-human-review",
      "label": "Human review",
      "action": "human_review",
      "workflow": "feature-delivery",
      "phase": "review",
      "description": "Route the task to a human reviewer.",
      "aliases": ["human-review"]
    },
    {
      "value": "incident",
      "label": "Incident",
      "action": "human_review",
      "workflow": "incident-response",
      "phase": "clarify",
      "description": "Incident response or RCA work that needs human steering."
    },
    {
      "value": "ops",
      "label": "Ops",
      "action": "maintenance_manual",
      "description": "Operational task; not Codex coding work.",
      "aliases": ["operation", "operations"]
    },
    {
      "value": "maintenance",
      "label": "Maintenance",
      "action": "maintenance_manual",
      "description": "Manual maintenance task.",
      "aliases": ["workspace-maintenance"]
    },
    {
      "value": "loop-complete",
      "label": "Loop complete",
      "action": "loop_complete",
      "workflow": "feature-delivery",
      "phase": "review",
      "description": "Mark the review loop complete."
    }
  ],
  "evaluators": ["risk-evaluator", "architecture-impact-evaluator", "rollout-safety-check"]
}
