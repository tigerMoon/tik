{
  "name": "tik",
  "version": "0.1.0",
  "private": true,
  "description": "Observable, Controllable, Convergent Tik",
  "type": "module",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.26.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "pnpm run check:generated-artifacts && node scripts/check-readme-links.mjs && turbo run test && pnpm run test:multi-agent-skill",
    "check:generated-artifacts": "node scripts/check-generated-artifacts.mjs",
    "test:multi-agent-skill": "node codex-skill/tik-multi-agent-workflow/scripts/test-tik-multi-agent-workflow.mjs",
    "lint": "turbo run lint",
    "clean": "turbo run clean && rm -rf node_modules",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "turbo": "^1.12.0",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
  },
  "packageManager": "pnpm@10.26.0",
  "workspaces": [
    "packages/*"
  ]
}
